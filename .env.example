# Copy to .env (which is git-ignored) and fill in what you use.

# --- Models (OpenRouter is the default provider) ----------------------------
OPENROUTER_API_KEY=
# Default model for agent-played sides. Any OpenRouter id works; run
# `caseagent models` to browse. Use `openai:<model>` for OpenAI directly or
# `custom:<model>` for your own OpenAI-compatible endpoint (see below).
CASEAGENT_MODEL=anthropic/claude-opus-5.5
# Reasoning effort to request where the model supports it
# (low, medium, high, xhigh, max; "default" sends nothing).
CASEAGENT_EFFORT=high
# Output-token cap. Leave unset to size it from the model's catalog entry.
# CASEAGENT_MAX_TOKENS=64000
# Seconds to wait on a single model call.
# CASEAGENT_LLM_TIMEOUT=900

# OpenAI directly: `-m openai:gpt-...`
# OPENAI_API_KEY=

# Your own OpenAI-compatible endpoint: `-m custom:<model>`
# CASEAGENT_LLM_BASE_URL=http://localhost:11434/v1
# CASEAGENT_LLM_API_KEY=

# --- DecisionLayer -----------------------------------------------------------
# A production key (dvarb_...) from /settings/api-keys. Simulations reject test
# keys (dvarb_test_..., from /settings/test-api-keys) with 403. Simulated awards
# are published at a public link for 30 days; the allowance is 10 a month by default.
DECISIONLAYER_API_KEY=
DECISIONLAYER_BASE_URL=https://staging.decisionlayer.ai

# --- Where things live (defaults shown) --------------------------------------
# CASEAGENT_CASES_DIR=cases
# CASEAGENT_RUNS_DIR=runs
# CASEAGENT_CACHE_DIR=~/.cache/caseagent
